# Copy this file to .env.local and fill in your own Supabase project values.
# Find these in your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google Sheets sync (optional — only needed if you want the
# Sync from Sheet / Sync to Sheet / auto-append-on-create features).
# See README.md "Part 7" for how to get these.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKeyContentGoesHere\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=the-id-from-your-sheets-url
